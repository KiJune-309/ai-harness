# Run pnpm deploy:init, or copy this file to infra/.env.production and fill it in.
# Never commit the populated file. See docs/deployment.md for Windows commands.
# localhost uses automatic local HTTPS; import Caddy's root certificate on Windows.
# Use only a hostname here (no scheme, path, or port).
APP_DOMAIN=localhost
# Optional alternate ports when another application already uses 80/443.
# Host and container ports stay identical so HTTP redirects preserve the HTTPS port.
HTTP_PORT=80
HTTPS_PORT=443

# pnpm deploy:init generates EACH of these four values independently.
# Manual PowerShell generation is documented in docs/deployment.md.
# Keep them stable across restarts and upgrades, and back them up privately.
# POSTGRES_PASSWORD must be hexadecimal because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
HARNESS_API_TOKEN=
ACCOUNT_ENCRYPTION_KEY=
S3_SECRET_ACCESS_KEY=
# Private MinIO administrator/access key, at least three characters.
S3_ACCESS_KEY_ID=harness-storage

# Server-owned system model. Never put these values in NEXT_PUBLIC_* variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_MS=120000

# Optional image overrides; pin reviewed tags or digests for your release.
CADDY_IMAGE=caddy:2.11.7-alpine
MINIO_IMAGE=ai-harness-minio:RELEASE.2025-04-22T22-12-26Z

COLLABORATION_POLL_MS=500
COLLABORATION_LEASE_MS=30000
COLLABORATION_WAIT_MS=604800000
