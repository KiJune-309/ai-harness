# Include only inputs needed to compile the application images.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!scripts/
!scripts/build-server.mjs
!apps/
!apps/api/
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src/
!apps/api/src/**
!apps/web/
!apps/web/**
!packages/
!packages/**

# Never send private settings, local dependencies or prior build output to Docker.
**/.env
**/.env.*
**/.local
**/.git
**/node_modules
**/.pnpm-store
**/.next
**/dist
**/build
**/coverage
**/out
**/*.tsbuildinfo
**/tests
**/*.test.*
**/*.spec.*
apps/api/lib
packages/contracts/lib
packages/db/lib
packages/core/*/lib
