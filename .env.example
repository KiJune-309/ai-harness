DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_MS=120000

# pnpm dev creates a private token in ignored .local/ when this is empty.
# Set the same private value on Web and API when deploying separately.
HARNESS_API_TOKEN=
HARNESS_API_URL=http://127.0.0.1:3001
HARNESS_WORKSPACE_ID=personal
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=3000

# Configure PostgreSQL for durable history. Temporary memory is development-only.
DATABASE_URL=
CHAT_STORE=memory
