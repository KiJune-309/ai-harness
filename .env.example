# For production Docker Compose + Caddy, use infra/.env.example and docs/deployment.md.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODELS=deepseek-flash,deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_MS=120000

# pnpm dev creates a private token in ignored .local/ when this is empty.
# Set the same private value on Web and API when deploying separately.
HARNESS_API_TOKEN=
HARNESS_API_URL=http://127.0.0.1:3001
HARNESS_WORKSPACE_ID=personal
# A stable 64-character hex key is required with PostgreSQL. pnpm dev creates one in .local/.
ACCOUNT_ENCRYPTION_KEY=
# Optional comma-separated exact origins for administrator-approved local model servers.
OPENAI_ALLOWED_LOCAL_ORIGINS=
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=3000

# pnpm dev starts a dedicated local PostgreSQL with a persistent Docker volume.
# Set DATABASE_URL to use your own PostgreSQL instead; independent API startup requires it.
# Keep .local/ private and preserve its credentials together with the database volume.
DATABASE_URL=

# pnpm dev starts private MinIO with a persistent volume when all S3 fields are empty.
# Configure all four fields to use an external private S3-compatible object service.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=false

# Durable in-app collaboration worker (PostgreSQL required).
COLLABORATION_POLL_MS=500
COLLABORATION_LEASE_MS=30000
COLLABORATION_WAIT_MS=604800000
