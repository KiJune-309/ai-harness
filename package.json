{
    "name": "ai-harness",
    "private": true,
    "version": "1.0.0",
    "description": "AI chat monorepo",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.5.2",
            "onFail": "download"
        }
    },
    "type": "module",
    "scripts": {
        "dev:web": "pnpm --filter @ai-harness/web dev",
        "build:web": "pnpm build:contracts && pnpm --filter @ai-harness/web build",
        "start:web": "pnpm --filter @ai-harness/web start",
        "typecheck:web": "pnpm --filter @ai-harness/web typecheck",
        "commit": "node scripts/commit.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky",
        "build:core": "tsc -b packages/core/tsconfig.json",
        "typecheck:core": "tsc -p packages/core/tsconfig.check.json",
        "dev": "node scripts/dev.mjs",
        "db:up": "node scripts/local-database.mjs up",
        "db:stop": "node scripts/local-database.mjs stop",
        "dev:api": "pnpm --filter @ai-harness/api dev",
        "build:api": "node scripts/build-server.mjs",
        "start:api": "pnpm --filter @ai-harness/api start",
        "typecheck:api": "pnpm --filter @ai-harness/api typecheck",
        "build:contracts": "pnpm --filter @ai-harness/contracts build",
        "objects:up": "node scripts/local-object-storage.mjs up",
        "objects:stop": "node scripts/local-object-storage.mjs stop",
        "deploy:init": "node scripts/init-deployment.mjs",
        "deploy:build": "docker compose -f infra/build.compose.yaml build",
        "deploy:up": "docker compose --env-file infra/.env.production -f infra/production.compose.yaml up -d --wait --wait-timeout 180",
        "deploy:logs": "docker compose --env-file infra/.env.production -f infra/production.compose.yaml logs -f --tail=100 caddy web api",
        "deploy:stop": "docker compose --env-file infra/.env.production -f infra/production.compose.yaml stop"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "^16.3.6",
        "@types/node": "^26.6.3",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "vitest": "^5.0.3",
        "fast-check": "^4.9.0"
    },
    "deepseekHarness": {
        "repository": "https://github.com/deepseek-ai/deepseek-harness",
        "commit": "1517a4dbca0a2789ff1d41ba439600f8547d23fa",
        "path": "packages/core"
    }
}
