{
    "name": "@deepseek-ai/dsh-agent-default-model",
    "description": "Default model selection shared by Agent entry points",
    "version": "0.2.1-alpha.5",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
        "directory": "packages/core/agent-default-model"
    },
    "type": "module",
    "main": "lib/types/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/types/index.js"
        },
        "./src/*": "./src/*",
        "./package.json": "./package.json",
        "./locale/*.json": "./locale/*.json"
    },
    "files": [
        "locale/*.json",
        "lib/types/**/*.d.ts",
        "lib/types/**/*.js"
    ],
    "license": "MIT",
    "dependencies": {
        "@deepseek-ai/schemastery": "3.18.5-alpha.2",
        "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.5"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh-agent": "workspace:*",
        "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
        "@deepseek-ai/cordis": "4.0.5-alpha.2"
    },
    "devDependencies": {
        "@deepseek-ai/dsh-agent": "workspace:*",
        "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
        "@deepseek-ai/cordis": "4.0.5-alpha.2",
        "@deepseek-ai/dsh-settings": "0.2.1-alpha.5"
    },
    "private": true,
    "scripts": {
        "build": "tsc -b"
    }
}
