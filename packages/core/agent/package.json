{
    "name": "@deepseek-ai/dsh-agent",
    "description": "Agent interface, registry, initiator scope, and event vocabulary for the DeepSeek Harness",
    "version": "0.2.1-alpha.5",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
        "directory": "packages/core/agent"
    },
    "type": "module",
    "main": "lib/types/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/types/index.js"
        },
        "./types": {
            "types": "./lib/types/types.d.ts",
            "default": "./lib/types/types.js"
        },
        "./src/*": "./src/*",
        "./package.json": "./package.json",
        "./locale/*.json": "./locale/*.json"
    },
    "files": [
        "locale/*.json",
        "lib/types/**/*.js",
        "lib/types/**/*.d.ts"
    ],
    "license": "MIT",
    "peerDependencies": {
        "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-scope": "workspace:*",
        "@deepseek-ai/dsh-session": "workspace:*",
        "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-system-prompt": "workspace:*",
        "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-workspace": "0.2.1-alpha.5",
        "@deepseek-ai/cordis": "4.0.5-alpha.2"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh-workspace": {
            "optional": true
        }
    },
    "devDependencies": {
        "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-scope": "workspace:*",
        "@deepseek-ai/dsh-session": "workspace:*",
        "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-system-prompt": "workspace:*",
        "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-util-values": "0.2.1-alpha.5",
        "@deepseek-ai/dsh-workspace": "0.2.1-alpha.5",
        "@deepseek-ai/cordis": "4.0.5-alpha.2"
    },
    "private": true,
    "scripts": {
        "build": "tsc -b"
    }
}
