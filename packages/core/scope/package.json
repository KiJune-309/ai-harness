{
    "name": "@deepseek-ai/dsh-scope",
    "description": "Scoped-context registration primitive (scope tags, scope-filtered event dispatch) for the DeepSeek Harness",
    "version": "0.2.1-alpha.5",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
        "directory": "packages/core/scope"
    },
    "type": "module",
    "main": "lib/types/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/types/index.d.ts",
            "default": "./lib/types/index.js"
        },
        "./src/*": "./src/*",
        "./package.json": "./package.json"
    },
    "files": [
        "lib/types/**/*.d.ts",
        "lib/types/**/*.js"
    ],
    "license": "MIT",
    "peerDependencies": {
        "@deepseek-ai/cordis": "4.0.5-alpha.2"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.0.5-alpha.2"
    },
    "private": true,
    "scripts": {
        "build": "tsc -b"
    }
}
